# 复制成 .env 再填值：
#
#   cp .env.example .env
#
# .env 已经被 .gitignore 排除 —— 它装着数据库密码和 JWT 密钥，
# 提交上去等于把生产凭证公开。这份 .example 只放占位符。

POSTGRES_USER=todo
POSTGRES_DB=todo

# 数据库密码。
# compose 里写的是 ${POSTGRES_PASSWORD:?...}，留空会让 up 直接报错退出，
# 而不是用一个空密码把数据库静默起起来。
POSTGRES_PASSWORD=

# JWT 签名密钥。
# HS256 的全部安全性都押在它上面，至少 32 字节。生成方式：
#   openssl rand -hex 32
# 后端启动时会校验长度，不足会拒绝启动。
JWT_SECRET=
